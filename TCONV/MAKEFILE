# Thai Converter makefile.

!ifndef assembler
!   define assembler wasm
!endif

!ifndef c_compiler
#!   define c_compiler wcc386
!   define c_compiler wcc
!endif

!ifndef linker
!   define linker wlink
!endif

!ifndef asm_options
!   define asm_options -zq -d1
!endif

!ifndef c_options
!   define c_options -zq -d1
!endif

.extensions:
.extensions: .com .exe .lnk .obj .c .asm

.asm.obj: .AUTODEPEND
    $(assembler) $(asm_options) $[*

.c.obj: .AUTODEPEND
    $(c_compiler) $(c_options) $[*

##############################################################################
# cuw2cw.exe
##############################################################################

cuw2cw: .SYMBOLIC cuw2cw.exe

cuw2cw.exe: main.obj cuw2cw.obj cuw2cw.lnk
    $(linker) @cuw2cw.lnk
    wstrip cuw2cw.exe

cuw2cw.lnk: $(__MAKEFILES__)
    @%create $@
    @%append $@ NAME    cuw2cw
    @%append $@ OPTION  quiet, eliminate, map, show
    @%append $@ DEBUG   all
    @%append $@ FILE    main.obj,cuw2cw.obj

##############################################################################
