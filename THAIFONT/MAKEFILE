# Thai Display Font makefile.

!ifndef assembler
!   define assembler wasm
!endif

!ifndef c_compiler
#!   define c_compiler wcc386
!   define c_compiler wcc
!endif

!ifndef linker
!   define linker wlink
!endif

!ifndef asm_options
!   define asm_options -zq -d1
!endif

!ifndef c_options
!   define c_options -zq -d1
!endif

.extensions:
.extensions: .com .exe .lnk .obj .c .asm

.asm.obj: .AUTODEPEND
    $(assembler) $(asm_options) $[*

.c.obj: .AUTODEPEND
    $(c_compiler) $(c_options) $[*

##############################################################################
# bin2inc.exe
##############################################################################

bin2inc: .SYMBOLIC bin2inc.exe

bin2inc_objs = bin2inc.obj

bin2inc.exe: $(bin2inc_objs) bin2inc.lnk
    $(linker) @bin2inc.lnk

bin2inc.lnk: $(__MAKEFILES__)
    @%create $@
    @%append $@ NAME    bin2inc
    @%append $@ OPTION  quiet, eliminate, map, show
    @%append $@ DEBUG   all
    @%append $@ FILE    $(bin2inc_objs)
    #@for %i in ($(bin2inc_objs)) do @%append $@ FILE    %i

##############################################################################
# bin2inc2.exe
##############################################################################

bin2inc2: .SYMBOLIC bin2inc2.exe

bin2inc2_objs = bin2inc2.obj

bin2inc2.exe: $(bin2inc2_objs) bin2inc2.lnk
    $(linker) @bin2inc2.lnk

bin2inc2.lnk: $(__MAKEFILES__)
    @%create $@
    @%append $@ NAME    bin2inc2
    @%append $@ OPTION  quiet, eliminate, map, show
    @%append $@ DEBUG   all
    @%append $@ FILE    $(bin2inc2_objs)
    #@for %i in ($(bin2inc2_objs)) do @%append $@ FILE    %i

##############################################################################
# rorg.com
##############################################################################

rorg: .SYMBOLIC rorg.com

